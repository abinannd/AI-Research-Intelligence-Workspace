# Copy to .env (never commit secrets). Used by docker compose in infra/.

POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research
DATABASE_URL=postgresql+psycopg2://research:research@postgres:5432/research

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=research_chunks

CORS_ORIGINS=http://localhost:3000

MAX_PDF_BYTES=20971520
MAX_PDF_PAGES=80

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
HF_HOME=/models

STORAGE_BACKEND=s3
QUEUE_BACKEND=rq
VECTOR_BACKEND=qdrant
EMBEDDING_BACKEND=st
LLM_BACKEND=hf

PROMPT_VERSION=cited-qa-v1
RETRIEVAL_VERSION=bge-small-top8-v1

NEXT_PUBLIC_API_URL=http://localhost:8000
