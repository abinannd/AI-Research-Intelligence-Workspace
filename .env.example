# Local-only configuration template. Copy to .env and fill every blank secret.
# Never commit .env. Docker Compose should be run with --env-file .env.

POSTGRES_USER=research
POSTGRES_PASSWORD=
POSTGRES_DB=research
DATABASE_URL=postgresql+psycopg2://research:@localhost:5432/research

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=documents
MINIO_SECURE=false

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=research_chunks

CORS_ORIGINS=http://localhost:3000

MAX_PDF_BYTES=20971520
MAX_PDF_PAGES=80

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
HF_HOME=./models

STORAGE_BACKEND=s3
QUEUE_BACKEND=rq
VECTOR_BACKEND=qdrant
EMBEDDING_BACKEND=st
LLM_BACKEND=hf

PROMPT_VERSION=cited-qa-v1
RETRIEVAL_VERSION=bge-small-top8-v1
RETRIEVAL_TOP_K=8

NEXT_PUBLIC_API_URL=http://localhost:8000
